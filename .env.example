# Copie para .env e preencha. NUNCA commite o .env.

# Banco da aplicação (Neon). Use o driver psycopg e mantenha o sslmode:
# postgresql+psycopg://USUARIO:SENHA@HOST/BANCO?sslmode=require
DATABASE_URL=

# Banco usado pelos testes. Se vazio, os testes usam SQLite temporário.
# NUNCA aponte para o banco de produção.
TEST_DATABASE_URL=

# Versão exibida em GET /version
APP_VERSION=dev

# Desconto máximo permitido em porcentagem
DESCONTO_MAXIMO=50

# Porta do servidor (o Render define automaticamente)
PORT=8000

# Feature flag: exibe a origem dos cafés no cardápio
FEATURE_CARDAPIO_ORIGEM=false
